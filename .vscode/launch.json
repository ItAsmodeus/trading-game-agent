{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🎮 Train — Swing",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": ["--symbol", "BTC/USDT", "--mode", "swing", "--timesteps", "10000"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/bin/python3.14",
            "justMyCode": false
        },
        {
            "name": "🔄 Rolling Trainer",
            "type": "debugpy",
            "request": "launch",
            "module": "training.rolling_trainer",
            "args": ["--symbol", "BTC/USDT", "--timeframe", "1d", "--timesteps", "5000"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/bin/python3.14",
            "justMyCode": false
        },
        {
            "name": "📊 News Fetcher",
            "type": "debugpy",
            "request": "launch",
            "module": "data.news_fetcher",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/venv/bin/python3.14",
            "justMyCode": false
        },
        {
            "name": "💰 Funding Rate",
            "type": "debugpy",
            "request": "launch",
            "module": "data.binance_funding",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
